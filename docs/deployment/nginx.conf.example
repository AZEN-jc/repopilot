# =============================================================================
# nginx template for a RepoPilot host install.
#
# This is the *host* variant: nginx is installed on the machine, TLS terminates
# here, and the API listens on 127.0.0.1:4000. If you are using
# `docker-compose.yml` instead, you do not need this file — the edge config is
# baked into the `web` image from `deploy/nginx/repopilot.conf`.
#
# Both variants route identically, and they have to: the browser is the same
# browser. The routing table is:
#
#   /            → the built UI (`apps/web/dist`), SPA fallback
#   /assets/*    → the same directory, immutable, hashed filenames
#   /api/*       → the API
#   /health      → the API
#   /docs/*      → the API (the OpenAPI document)
#
# The API used to be the public root here, with the UI left commented out at an
# `/app/` subpath. That is not a deployable shape: the API's `GET /` answers a
# JSON service index, so a visitor to the domain got a JSON blob. The UI is what
# a visitor asks for, so the UI gets `/`.
#
# Before you use this:
#
#   1. Replace `example.com` with your domain, everywhere.
#   2. Build the UI:  pnpm --filter @repopilot/web build
#      and point `root` at the resulting `apps/web/dist`.
#   3. Issue a certificate (certbot --nginx -d example.com).
#   4. Make sure the API is NOT reachable from the internet directly. See the
#      warning at the bottom — it is a forged-IP surface, not just untidiness.
#
#   sudo cp nginx.conf.example /etc/nginx/sites-available/repopilot.conf
#   sudo ln -s /etc/nginx/sites-available/repopilot.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

upstream repopilot_api {
    server 127.0.0.1:4000;
    keepalive 32;
}

# -- HTTP -> HTTPS redirect ---------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Allow the Let's Encrypt http-01 challenge through before redirecting.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -- HTTPS -------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS belongs here and only here: this is the block where the connection is
    # actually https. Declaring it on an http:// origin is ignored by browsers.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Do not advertise the nginx version.
    server_tokens off;

    # The UI. `pnpm --filter @repopilot/web build` writes here.
    root /opt/repopilot/apps/web/dist;
    index index.html;

    # -------------------------------------------------------------------------
    # Response headers
    # -------------------------------------------------------------------------
    #
    # Careful: nginx's `add_header` inheritance is all-or-nothing per block. The
    # moment a `location` declares any `add_header`, everything inherited from
    # this block is discarded. The two locations below that set `Cache-Control`
    # therefore repeat the security set — if you add a header here, add it there
    # too, or factor all of them into an `include` file (which is what
    # `deploy/nginx/snippets/repopilot-security.conf` does for the container
    # variant).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    # -------------------------------------------------------------------------
    # Compression
    # -------------------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    # -------------------------------------------------------------------------
    # Request size
    # -------------------------------------------------------------------------
    #
    # The API hard-limits JSON bodies at 64 KB. This is deliberately larger so
    # the API is the one that rejects, in its own JSON envelope, rather than
    # nginx returning a bare HTML 413 a JSON client cannot parse.
    client_max_body_size 128k;

    # -------------------------------------------------------------------------
    # API
    # -------------------------------------------------------------------------

    proxy_http_version 1.1;

    # WARNING — X-Forwarded-For is load-bearing, not cosmetic.
    #
    # The API's rate limiter reads this header *only* when the socket peer is a
    # proxy named in `TRUSTED_PROXY_IPS`, whose built-in default is loopback
    # (`127.0.0.1,::1,::ffff:127.0.0.1`). That default covers this file's
    # topology and nothing else: the `upstream` above points at
    # `127.0.0.1:4000`, so the API's peer really is loopback. Change the
    # upstream to a remote host or a container address and you must set
    # `TRUSTED_PROXY_IPS` to that address, or every client behind this proxy is
    # keyed by the proxy and shares one bucket — 60/min for the whole service
    # rather than per caller.
    #
    # Dropping the header is the same failure reached from the other side: the
    # API keys every request by the proxy's address, which is on its allow-list,
    # so the limiter stops limiting. Neither direction is a bypass; both are the
    # limiter quietly not doing per-client accounting. See R-24.
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host              $host;
    # Needed for the `keepalive` on the upstream to do anything.
    proxy_set_header Connection        "";

    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    location /api/ {
        proxy_pass http://repopilot_api;
    }

    location = /health {
        access_log off;
        proxy_pass http://repopilot_api;
    }

    location /docs/ {
        proxy_pass http://repopilot_api;
    }

    # -------------------------------------------------------------------------
    # Static UI
    # -------------------------------------------------------------------------

    # Hashed filenames: safe to cache forever. `try_files ... =404` so a missing
    # asset is a clean 404 instead of an HTML document served as JavaScript.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;
        try_files $uri =404;
    }

    # The entry document names the current asset hashes, so it must never be
    # cached. `try_files`'s `/index.html` fallback lands here too, which is what
    # gives the SPA its client-side routes without caching them.
    location = /index.html {
        expires -1;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }
}

# =============================================================================
# WARNING — the API must not be reachable from the internet.
#
# `apps/api/src/server.ts` passes `TRUSTED_PROXY_IPS` to Fastify's
# `trustProxy`, so `req.ip` follows `X-Forwarded-For` only from an address you
# named. The rate limiter does not read `req.ip` — it keys on the socket peer
# and trusts the header only from a proxy named in `TRUSTED_PROXY_IPS` — so a
# directly reachable API is no longer a rate-limit bypass. What is left of the
# risk is a log line that reports whatever a direct client typed.
#
#   * Bind it to loopback: `HOST=127.0.0.1`.
#   * Do not open port 4000 in the firewall.
#   * If you front it with a second proxy or a load balancer, that proxy must
#     also set `X-Forwarded-For`, and it must append rather than replace — and
#     its address must be in `TRUSTED_PROXY_IPS`, or its clients share one
#     bucket.
# =============================================================================
